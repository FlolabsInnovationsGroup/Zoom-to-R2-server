# ============================================================================
# FloLabs Meetings Archive: environment variables
# Copy to .env (gitignored) and fill in. NEVER paste these values into chat,
# docs, tickets or git. On the Hetzner server the same names go into
# /etc/zoom-archive/env (mode 640), used by the sync and the web service.
# ============================================================================

# --- 1. Zoom Server-to-Server OAuth app (created by John, Owner account) ---
# Zoom Marketplace > Develop > Build App > Server-to-Server OAuth > App Credentials
# Read-only scopes: user:read:list_users:admin,
#   cloud_recording:read:list_user_recordings:admin,
#   cloud_recording:read:list_recording_files:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# How downloads authenticate: auto (try header, then ?access_token), header, query
ZOOM_DOWNLOAD_AUTH=auto
# Fallback user list, used only if the app lacks user:read:list_users:admin (not secret)
ZOOM_USER_EMAILS=john@flomadlabs.com,PM@flomad.com,zoom.buddy@flolabsinnovations.com

# --- 2. Cloudflare R2 (sync writes the archive) ---
# Cloudflare > R2 > Manage API tokens > Create: "Object Read & Write", bucket zoom-archive-test only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zoom-archive-test
# Optional but recommended: a second R2 token, "Object Read only" on the same bucket. The web app (MCP links,
# admin pages) then uses it instead of the read-write key above.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# --- 3. Sync settings (not secret) ---
MANIFEST_PATH=/var/lib/zoom-archive/manifest.sqlite
TEAMS_YAML=/opt/zoom-archive/app/sync/teams.yaml
LOG_DIR=/var/log/zoom-archive
SYNC_CONCURRENCY=6
# Optional: URL that receives a JSON POST when a run fails (Slack/Google Chat incoming webhook)
ALERT_WEBHOOK_URL=

# --- 4. Admin page + MCP server (one Python web app; Caddy gives it HTTPS) ---
# The web service needs this whole file (Zoom + R2 too): its Start backfill button runs the sync with it.
# Password for /admin (long, random)
ADMIN_PASSWORD=
# Signs the login cookie: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=
# SQLite file with the API keys (hash only) and the access log
KEYS_DB_PATH=/var/lib/zoom-archive/keys.sqlite
# Optional: full-text search database (default: search.sqlite next to MANIFEST_PATH)
SEARCH_DB_PATH=
# Where the web app listens (Caddy proxies to it)
ADMIN_BIND=127.0.0.1:8080
# Public domain, used only by Caddy (deploy/Caddyfile), e.g. meetings.example.com
DOMAIN=
